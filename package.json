{
  "name": "memory-mirror",
  "version": "1.0.0",
  "description": "MTG Memory Mirror - A transcript processing service for Magic: The Gathering card extraction",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "prisma:generate": "prisma generate --schema=db/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=db/schema.prisma",
    "prisma:migrate:prod": "prisma migrate deploy --schema=db/schema.prisma",
    "worker": "ts-node jobs/workers/transcriptWorker.ts",
    "worker:prod": "node dist/jobs/workers/transcriptWorker.js"
  },
  "prisma": {
    "schema": "db/schema.prisma"
  },
  "keywords": [
    "mtg",
    "magic-the-gathering",
    "nlp",
    "fastify",
    "bullmq",
    "prisma"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bullmq": "^5.25.5",
    "fastify": "^5.1.0",
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
